PORT=5173
ADMIN_PASSWORD=change-me-before-deploy
AUTH_SECRET=change-me-before-deploy
AUTH_MOCK_ENABLED=true

# Docker Compose local defaults. Production should replace password, host and database credentials.
MONGODB_URI=mongodb://delivery:delivery@mongodb:27017/delivery_pipeline?authSource=admin
MONGODB_DB=delivery_pipeline
REDIS_URL=redis://redis:6379
PUBLIC_APP_URL=https://your-domain.example.com
SATISFACTION_AUTO_GOOD_DAYS=7

# Feishu / Lark OAuth. Set AUTH_MOCK_ENABLED=false after these values are ready.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_REDIRECT_URI=https://your-domain.example.com/api/auth/lark/callback
LARK_AUTH_HOST=https://open.feishu.cn
LARK_API_HOST=https://open.feishu.cn

# Optional role mapping for Feishu OAuth users. Comma-separated open_id or email values.
LARK_SUPER_ADMIN_OPEN_IDS=
LARK_SUPER_ADMIN_EMAILS=
LARK_DELIVERY_ADMIN_OPEN_IDS=
LARK_DELIVERY_ADMIN_EMAILS=

# Feishu Base configuration.
LARK_BASE_TOKEN=
LARK_WIKI_NODE_TOKEN=ZqC3whTTXiU2rUkLdRycTtmhnYE
LARK_BASE_WEB_URL=https://aicarrier.feishu.cn/wiki/ZqC3whTTXiU2rUkLdRycTtmhnYE
LARK_LEDGER_TABLE_ID=tbl7FrAYMpseNuPA
LARK_LEDGER_VIEW_ID=vewkBG8gpp
LARK_245_TABLE_ID=tbl6dWpodWYuWNq7
LARK_245_VIEW_ID=vew41dhWuZ
LARK_GAOFENG_TABLE_ID=tbl8iFcCizgi0YrU
LARK_GAOFENG_VIEW_ID=vewkBG8gpp
# Optional overrides when a table is not under LARK_BASE_WEB_URL.
LARK_LEDGER_URL=
LARK_245_URL=
LARK_GAOFENG_URL=
# Shared secret sent by the three Base workflows to the real-time sync endpoint.
LARK_BASE_WEBHOOK_SECRET=
LARK_SYNC_INTERVAL_MS=300000

# Optional bot webhook for status-change notifications.
LARK_WEBHOOK_URL=
